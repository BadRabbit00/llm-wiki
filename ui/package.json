{
  "name": "llm-wiki-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests/*.ts *.ts *.json index.html",
    "format:check": "prettier --check src tests/*.ts *.ts *.json index.html",
    "postbuild": "node -e \"require('node:fs').writeFileSync('dist/.gitkeep', '')\"",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "d3-force": "3.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
