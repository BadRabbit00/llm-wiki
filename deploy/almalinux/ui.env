WIKI_UI_BIND=127.0.0.1:8789
WIKI_UI_WIKISVC_URL=http://127.0.0.1:8787
WIKI_UI_AGENT_URL=http://127.0.0.1:8788
# Configure Authentik before starting wiki-ui. Secrets live only in the files below.
WIKI_UI_OIDC_ISSUER=
WIKI_UI_OIDC_CLIENT_ID=
WIKI_UI_OIDC_SECRET_FILE=/etc/llm-wiki/ui-oidc.secret
WIKI_UI_SESSION_TOKEN_FILE=/etc/llm-wiki/ui-session.token
WIKI_UI_OIDC_REDIRECT_URL=https://wiki.example.org/auth/callback
WIKI_UI_COOKIE_SECURE=1
# Private CA: include the system roots and the organization's CA in this PEM bundle.
# SSL_CERT_FILE=/etc/llm-wiki/idp-ca.pem
# Local tests only: WIKI_UI_OIDC_INSECURE_HTTP=1, WIKI_UI_COOKIE_SECURE=0
