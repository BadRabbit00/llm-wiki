# An installed llama.cpp build with support for your Gemma 4 GGUF.
# It must be executable by llm-model, outside /home and /root.
LLAMA_SERVER_BIN=/opt/llama.cpp/bin/llama-server
LLAMA_ARG_MODEL=/srv/llm-wiki/models/gemma-4-31b.gguf
LLAMA_ARG_ALIAS=wiki-gemma-31b
LLAMA_ARG_HOST=127.0.0.1
LLAMA_ARG_PORT=18089
# Match context in wikiagent.yaml. Start with one slot; tune after checking VRAM.
LLAMA_ARG_CTX_SIZE=16384
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_N_GPU_LAYERS=auto
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CACHE_TYPE_K=q8_0
LLAMA_ARG_CACHE_TYPE_V=q8_0
LLAMA_ARG_JINJA=1
LLAMA_ARG_REASONING=off
