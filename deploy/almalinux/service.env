# systemd EnvironmentFile syntax; absolute paths, no shell expansion.
WIKI_ROOT=/var/lib/llm-wiki/wiki
STATE_DIR=/var/lib/llm-wiki/state
INDEX_DIR=/var/lib/llm-wiki/index
WIKIAGENT_STATE_DIR=/var/lib/llm-wiki/agent
WIKIAGENT_CONFIG=/etc/llm-wiki/wikiagent.yaml
BIND_HOST=127.0.0.1
BIND_PORT=8787
LOG_LEVEL=INFO
CORS_ORIGINS=
# MCP_HTTP_ENABLED=False
# MCP_HTTP_PATH=/mcp
# MCP_PROFILE=coding
MAX_UPLOAD_MB=25
MAX_LIBRARY_UPLOAD_MB=200
EXTRACT_JOB_TIMEOUT=600
