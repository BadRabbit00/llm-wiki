[Unit]
Description=Wiki web workspace
Wants=wikisvc.service wikiagent.service llm-wiki-updater.socket
After=network-online.target wikisvc.service llm-wiki-updater.socket
RequiresMountsFor=/nix/store /etc/llm-wiki /opt/llm-wiki
StartLimitIntervalSec=0

[Service]
# Container confinement is in llm-wiki-run.
Type=notify
NotifyAccess=all
Delegate=yes
KillMode=mixed
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=LLM_WIKI_CIDFILE=%t/%n.ctr-id
ExecStart=/opt/llm-wiki/current/bin/llm-wiki-run daemon wiki-ui
ExecStop=/usr/bin/podman stop --ignore --time 15 --cidfile %t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile %t/%n.ctr-id
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
