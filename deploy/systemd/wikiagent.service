[Unit]
Description=Wiki policy planner, chat and background jobs
Wants=wikisvc.service llm-wiki-model.service
After=network-online.target wikisvc.service llm-wiki-model.service
RequiresMountsFor=/nix/store /var/lib/llm-wiki /etc/llm-wiki /opt/llm-wiki
StartLimitIntervalSec=0

[Service]
# On stop the agent finishes open chat replies and pauses jobs at their next
# checkpoint; on start recover() resumes them. The long stop timeout is for that.
Type=notify
NotifyAccess=all
Delegate=yes
KillMode=mixed
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=LLM_WIKI_CIDFILE=%t/%n.ctr-id
ExecStartPre=/opt/llm-wiki/current/bin/llm-wiki-run once wikiagent wikiagent check --wait 600 --dependencies-only
ExecStart=/opt/llm-wiki/current/bin/llm-wiki-run daemon wikiagent
ExecStop=/usr/bin/podman stop --ignore --time 640 --cidfile %t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm --force --ignore --cidfile %t/%n.ctr-id
Restart=on-failure
RestartSec=10
TimeoutStartSec=660
TimeoutStopSec=660

[Install]
WantedBy=multi-user.target
