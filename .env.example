# Задайте абсолютные пути вне репозитория контента. Этот файл сам не загружается.
WIKI_ROOT=/path/to/work/wiki
STATE_DIR=/path/to/work/backend/.dev/state
INDEX_DIR=/path/to/work/backend/.dev/index
WIKIAGENT_STATE_DIR=/path/to/work/backend/.dev/agent
WIKIAGENT_CONFIG=/path/to/work/backend/wikiagent.yaml
# WIKIAGENT_TOKEN — отдельный writer kind=agent; храните значение как секрет.
# WIKI_TOKEN — токен CLI/MCP. Токен человека не передавайте модели.
CORS_ORIGINS=
LOG_LEVEL=INFO
MAX_UPLOAD_MB=25
MAX_LIBRARY_UPLOAD_MB=200
EXTRACT_JOB_TIMEOUT=600
